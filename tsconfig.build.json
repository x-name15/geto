{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": [
    "src/index.ts",
    "src/version.ts",
    "src/models/**/*",
    "src/errors/**/*",
    "src/core/entity.ts",
    "src/core/gateway.ts",
    "src/adapters/buffer-adapter.ts",
    "src/adapters/json-adapter.ts",
    "src/adapters/stream-adapter.ts",
    "src/adapters/process-adapter.ts",
    "src/storage/memory-storage.ts",
    "src/storage/file-storage.ts"
  ],
  "exclude": ["node_modules", "dist", "src/**/__tests__/**"]
}
